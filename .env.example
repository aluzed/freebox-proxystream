# Copy to .env and fill in. .env is gitignored: never commit real credentials.
#
# Every value below has a working default except the FTP ones, so you can
# delete any line you are not changing.

# ---------- Freebox FTP (required) ----------
FTP_HOST=mafreebox.freebox.fr:21
FTP_USER=
FTP_PASS=
FTP_TIMEOUT=30s

# ---------- Network ----------
# Bind to a private interface. Remote access is Tailscale's job, not this
# service's: there is no TLS here.
HTTP_ADDR=0.0.0.0:8080
# The range proxy that ffmpeg reads from. Loopback only, never expose it.
INTERNAL_ADDR=127.0.0.1:8081

# ---------- Authentication ----------
# There is no account here on purpose: credentials live in the SQLite database.
# Create the first one from the web UI on startup, or headless with
#   proxystream useradd <username>
# Manage them with `proxystream users` and `proxystream passwd`.
SESSION_TTL=720h
# Optional shared bearer token for scripts. Leave empty to disable.
API_TOKEN=

# ---------- Storage ----------
DB_PATH=./data/app.db
CACHE_DIR=./data/segments
SUBTITLE_DIR=./data/subs
# One frame grabbed from the middle of each file, used as its poster. Written
# once and kept: this is not a cache.
THUMB_DIR=./data/thumbs
CACHE_MAX_BYTES=53687091200
CACHE_TTL=336h

# ---------- Library ----------
# Preferred audio language, ISO 639-1. Picks the default track on a file that
# carries several. Titles are derived from your folder and file names; the
# synopsis is yours to write, from the media page.
PREFERRED_LANG=fr

# ---------- Transcoding ----------
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Which H.264 encoder to use. The default is software and works everywhere;
# the rest need the matching hardware, and are refused at startup if this
# ffmpeg was not built with them.
#   libx264            software, any capable CPU        (default)
#   h264_v4l2m2m       Raspberry Pi 3 / Pi 4
#   h264_vaapi         Linux with /dev/dri (Intel/AMD)
#   h264_qsv           Intel Quick Sync
#   h264_nvenc         NVIDIA
#   h264_videotoolbox  macOS / Apple Silicon
# Changing this changes the cache key: nothing already encoded is reused.
VIDEO_ENCODER=libx264
VAAPI_DEVICE=/dev/dri/renderD128

# Used by libx264; the hardware encoders map X264_CRF onto their own quality
# knob where they have one, and ignore the preset.
X264_PRESET=veryfast
X264_CRF=23
AUDIO_BITRATE=128k
SEGMENT_DURATION=4

# Output rendition when the player does not ask for one: 720 or 1080, nothing
# else. This caps the ENCODE, not the library: any source resolution is fine
# and a 2160p file is simply downscaled. Nothing is ever upscaled, so a 480p
# file stays 480p. Output height is min(chosen rendition, source height).
DEFAULT_HEIGHT=720
VIDEO_MAXRATE_720=3M
VIDEO_BUFSIZE_720=6M
VIDEO_MAXRATE_1080=6M
VIDEO_BUFSIZE_1080=12M

ENCODER_READAHEAD_SEGMENTS=15
ENCODER_IDLE_TIMEOUT=90s
MAX_CONCURRENT_ENCODERS=2

# debug | info | warn | error
LOG_LEVEL=info
